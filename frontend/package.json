{
  "name": "frontend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-excalidraw-assets.mjs --public && vite --port 6767",
    "build": "tsc -b && vite build && node scripts/copy-excalidraw-assets.mjs --dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "excalidraw:build-from-source": "bash scripts/build-excalidraw-from-source.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
