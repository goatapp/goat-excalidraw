    "@excalidraw/excalidraw": "file:vendor/excalidraw-excalidraw-0.18.0.tgz",
    "@excalidraw/fractional-indexing": "file:vendor/excalidraw-fractional-indexing-3.3.0.tgz",
    "@excalidraw/math": "file:vendor/excalidraw-math-0.18.0.tgz",
    "@excalidraw/utils": "file:vendor/excalidraw-utils-0.1.2.tgz",
    "@types/lodash": "^4.17.24",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jszip": "^3.10.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
