{
  "name": "frontend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-excalidraw-assets.mjs --public && vite --port 6767",
    "build": "tsc -b && vite build && node scripts/copy-excalidraw-assets.mjs --dist",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "excalidraw:build-from-source": "bash scripts/build-excalidraw-from-source.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/common": "file:vendor/excalidraw-common-0.18.0.tgz",
    "@excalidraw/element": "file:vendor/excalidraw-element-0.18.0.tgz",
    "@excalidraw/excalidraw": "file:vendor/excalidraw-excalidraw-0.18.0.tgz",
    "@excalidraw/fractional-indexing": "file:vendor/excalidraw-fractional-indexing-3.3.0.tgz",
    "@excalidraw/math": "file:vendor/excalidraw-math-0.18.0.tgz",
    "@excalidraw/utils": "file:vendor/excalidraw-utils-0.1.2.tgz",
    "@tailwindcss/vite": "4.3.3",
    "@types/lodash": "^4.17.25",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jszip": "^3.10.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "nanoid": ">=3.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "happy-dom": "^20.14.0",
    "jsdom": "^30.0.1",
    "oxlint": "1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
