    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.6",
    "dompurify": "^3.4.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsdom": "^29.0.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
