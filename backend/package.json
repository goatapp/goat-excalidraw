  "main": "index.js",
  "scripts": {
    "build": "DATABASE_URL=\"file:./prisma/dev.db\" prisma generate && tsc --checkers 4",
    "predev": "node scripts/predev-migrate.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "start": "node dist/index.js",
    "admin:recover": "node scripts/admin-recover.js",
    "dev:simulate-auth-onboarding:fresh": "node scripts/simulate-auth-onboarding.js --scenario fresh",
    "dev:simulate-auth-onboarding:migration": "node scripts/simulate-auth-onboarding.js --scenario migration",
    "dev:simulate-auth-onboarding:dry-run": "node scripts/simulate-auth-onboarding.js --scenario migration --dry-run",
    "oidc:doctor": "node scripts/oidc-doctor.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --checkers 4"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
